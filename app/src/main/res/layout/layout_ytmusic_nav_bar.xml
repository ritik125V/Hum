<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navBarRoot"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/oled_black"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- Hamburger Guide Button -->
    <FrameLayout
        android:id="@+id/btnNavGuide"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Guide">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_menu"
            app:tint="#FFFFFF"
            android:contentDescription="Menu" />
    </FrameLayout>

    <!-- YouTube Music Brand Logo & Wordmark -->
    <LinearLayout
        android:id="@+id/btnNavBrand"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_ytmusic_badge"
            android:contentDescription="YouTube Music" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Music"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02" />
    </LinearLayout>

    <!-- Flexible space between left brand and right actions -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <!-- Search Button -->
    <FrameLayout
        android:id="@+id/btnNavSearch"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Search">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_search"
            app:tint="#FFFFFF"
            android:contentDescription="Search" />
    </FrameLayout>

    <!-- Sign In Pill Button -->
    <TextView
        android:id="@+id/btnNavSignIn"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/bg_sign_in_pill"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="Sign in"
        android:textColor="#0F0F0F"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:clickable="true"
        android:focusable="true" />

    <!-- Three Dots Menu Button -->
    <FrameLayout
        android:id="@+id/btnNavMore"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="More options">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_more_vert"
            app:tint="#FFFFFF"
            android:contentDescription="More" />
    </FrameLayout>

</LinearLayout>
