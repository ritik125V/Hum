<?xml version="1.0" encoding="utf-8"?>
<FrameLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oled_black">

    <com.bravemusic.player.webview.MusicWebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="@color/oled_black" />

    <!-- Smooth Dual-Tone Gradient Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:progressDrawable="@drawable/bg_progress_gradient"
        android:visibility="gone" />

    <!-- Top Drop-down Loading Pill with Smooth Slide Animation -->
    <FrameLayout
        android:id="@+id/dropLoadingContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp"
        android:translationY="-120dp"
        android:visibility="gone"
        android:elevation="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_drop_loading_pill"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Dual-Tone Circular Loading Spinner -->
            <ProgressBar
                android:id="@+id/dropLoadingSpinner"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/neon_coral"
                android:indeterminateTintMode="src_in" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Loading..."
                android:textColor="#F0FFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </FrameLayout>

    <!-- Full-screen scrim to catch touches outside the drawer when open -->
    <View
        android:id="@+id/drawerScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="false" />

    <!-- Slide-in / Slide-out Edge Drawer pinned to the RIGHT edge (ergonomic for right-handed users) -->
    <FrameLayout
        android:id="@+id/drawerContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:elevation="14dp">

        <LinearLayout
            android:id="@+id/drawerCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_drawer_panel_right">

            <!-- Edge Tab Handle Section (clickable on right edge to slide in / slide out) -->
            <FrameLayout
                android:id="@+id/btnDrawerToggle"
                android:layout_width="26dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_drawer_handle_right_ripple"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Toggle Navigation Drawer">

                <!-- Chevron pointing left (<) when closed to prompt sliding out leftward -->
                <ImageView
                    android:id="@+id/ivDrawerChevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="#FFFFFF"
                    android:contentDescription="Toggle Drawer" />
            </FrameLayout>

            <!-- Vertical Separator between Handle and Dock -->
            <View
                android:layout_width="1dp"
                android:layout_height="64dp"
                android:background="#26FFFFFF" />

            <!-- Dock Section (Home Button on top + Divider + Settings Button below) -->
            <LinearLayout
                android:id="@+id/drawerDock"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- 1. Home Button (takes to YT Music home page) -->
                <FrameLayout
                    android:id="@+id/btnDrawerHome"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_drawer_btn_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="YouTube Music Home">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_home"
                        android:contentDescription="Home" />
                </FrameLayout>

                <!-- Subtle hairline separator -->
                <View
                    android:layout_width="24dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:background="#20FFFFFF" />

                <!-- 2. Settings Button (opens audio & app settings) -->
                <FrameLayout
                    android:id="@+id/btnDrawerSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_drawer_btn_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Settings">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings"
                        app:tint="#FFFFFF"
                        android:contentDescription="Settings" />
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</FrameLayout>
